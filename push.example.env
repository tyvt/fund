# Server酱 SendKey（敏感信息，勿提交到版本库）
# 注册地址: https://sct.ftqq.com
SERVERCHAN_SENDKEY=

# =============================================================================
# 各指数买入标准（可选覆盖，完整列表见 config.py）
# =============================================================================

# --- 投入预算（剩余可用额度，非全年总额）---
# REMAINING_INVESTMENT_BUDGET：当年剩余可投入金额（兼容旧名 ANNUAL_INVESTMENT_BUDGET）
# ANNUAL_INVESTMENT_TARGET：可选，显式指定全年目标；未设则按剩余额度外推
# REMAINING_INVESTMENT_BUDGET=72000
# ANNUAL_INVESTMENT_TARGET=144000
# BUY_AMOUNT_POSITION_ALLOC_ENABLED=true
# DIVIDEND_BUY_AMOUNT=300
# CN_BROAD_BUY_AMOUNT=100
# BACKTEST_OTHER_BUY_AMOUNT=300
# BUY_RANGE_LOOKBACK_DAYS=252
# BUY_NEAR_YEAR_LOW_RANGE_PCT=0.20
# BUY_NEAR_YEAR_LOW_DRAWDOWN_WAIVE_PCT=0.12
# BUY_MID_RANGE_POSITION_PCT=0.45
# BUY_MID_RANGE_MAX_ABOVE_LOW_PCT=0.06
# BUY_TREND_MA_DAYS=200
# BUY_TREND_SLOPE_LOOKBACK_DAYS=60
# BUY_TREND_MIN_MA_SLOPE_PCT=-0.025
# BUY_TREND_DOWNTREND_MAX_RANGE_PCT=0.12

# --- 红利指数（H30269，分指数配置，见 config.get_dividend_signal_config）---
# 全局默认（未单独配置的指数使用）:
# DIVIDEND_BUY_SPREAD_MIN=0.030
# DIVIDEND_BUY_SPREAD_PERCENTILE_MIN=35
# DIVIDEND_BUY_PE_PERCENTILE_MAX=75
# DIVIDEND_BUY_MAX_ABOVE_LOW_PCT=0.07
# DIVIDEND_SIGNAL_HISTORY_START=20150101
# DIVIDEND_SPREAD_10Y_WINDOW=2520
# DIVIDEND_SPREAD_HIGH_PERCENTILE_MIN=75
# H30269 低波动 默认: 利差分位≥56%, PE分位≤64%, 距60日低点涨幅≤7%
# DIVIDEND_H30269_BUY_SPREAD_PERCENTILE_MIN=56
# DIVIDEND_H30269_BUY_PE_PERCENTILE_MAX=64
# DIVIDEND_H30269_BUY_MAX_ABOVE_LOW_PCT=0.07

