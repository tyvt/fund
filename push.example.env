# CYB_SELL_TRAILING_MIN_HOLD_DAYS=120
# CYB_SELL_COST_LOOKBACK_DAYS=252

# --- 纳斯达克 100 NDX ---
# NDX_BUY_FORWARD_PE_PERCENTILE_MAX=75
# NDX_BUY_RATE_PERCENTILE_MAX=99
# NDX_FALLBACK_EXPECTED_GROWTH=0.19
