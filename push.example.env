# --- 红利指数（930955 / H30269，分指数配置，见 config.get_dividend_signal_config）---
# 全局默认（未单独配置的指数使用）:
# DIVIDEND_BUY_SPREAD_MIN=0.030
# DIVIDEND_BUY_SPREAD_PERCENTILE_MIN=35
# DIVIDEND_BUY_PE_PERCENTILE_MAX=75
# DIVIDEND_BUY_MAX_ABOVE_LOW_PCT=0.07
# DIVIDEND_BUY_LOW_LOOKBACK_DAYS=60
# 930955 低波100 默认: 利差分位≥31%, PE分位≤73%, 距60日低点涨幅≤7%
# DIVIDEND_930955_BUY_SPREAD_PERCENTILE_MIN=31
# DIVIDEND_930955_BUY_PE_PERCENTILE_MAX=73
# DIVIDEND_930955_BUY_MAX_ABOVE_LOW_PCT=0.07
# DIVIDEND_930955_BUY_LOW_LOOKBACK_DAYS=60
# H30269 低波动 默认: 利差分位≥56%, PE分位≤64%, 距60日低点涨幅≤7%
