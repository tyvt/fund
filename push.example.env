# CYB_BUY_MAX_ABOVE_LOW_PCT=0.06
# CYB_BUY_LOW_LOOKBACK_DAYS=90
# --- 创业板卖出（估值分位/PEG + 移动止盈；默认开启）---
# CYB_SELL_ENABLED=true
# CYB_SELL_PE_PERCENTILE_MIN=78
# CYB_SELL_PB_PERCENTILE_MIN=78
# CYB_SELL_PEG_HIST_MIN=3.0
# CYB_SELL_COMBO_PE_PERCENTILE_MIN=60
# CYB_SELL_COMBO_PB_PERCENTILE_MIN=60
