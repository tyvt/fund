SERVERCHAN_SENDKEY=

# =============================================================================
# 各指数买入标准（可选覆盖，完整列表见 config.py）
# =============================================================================

# --- 投入预算与买入金额 ---
# REMAINING_INVESTMENT_BUDGET=50000
# BUY_AMOUNT_DEFAULT=100
# BUY_AMOUNT_CHANGE_SCALE_ENABLED=true
# BUY_AMOUNT_CHANGE_SENSITIVITY=10
# BUY_AMOUNT_CHANGE_MIN_MULT=0.5
# BUY_AMOUNT_POSITION_ALLOC_ENABLED=true
# MARKET_REGIME_ENABLED=false
# MARKET_REGIME_PROXY_CODES=000852,399006,NDX
# NDX_BUY_AMOUNT=100
# SPX_BUY_AMOUNT=100
# BUY_RANGE_LOOKBACK_DAYS=252
# BUY_NEAR_YEAR_LOW_RANGE_PCT=0.20
# BUY_NEAR_YEAR_LOW_DRAWDOWN_WAIVE_PCT=0.12
# BUY_MID_RANGE_POSITION_PCT=0.45
# BUY_MID_RANGE_MAX_ABOVE_LOW_PCT=0.06
# BUY_TREND_MA_DAYS=200
# BUY_TREND_SLOPE_LOOKBACK_DAYS=60
# BUY_TREND_MIN_MA_SLOPE_PCT=-0.02
# BUY_TREND_DOWNTREND_MAX_RANGE_PCT=0.10

# --- 信号强度与冷却期（默认关闭；频次由硬门槛决定）---
# BUY_COOLDOWN_ENABLED=false
# BUY_COOLDOWN_DAYS=10
# BUY_COOLDOWN_DISABLED_CODES=NDX,SPX
# BUY_COOLDOWN_DROP_OVERRIDE_ENABLED=true
# BUY_COOLDOWN_DROP_OVERRIDE_PCT=0.05
# BUY_COOLDOWN_AMOUNT_SCALE_ENABLED=true
# BUY_COOLDOWN_AMOUNT_MAX_MULTIPLIER=3.0
# BUY_COOLDOWN_AMOUNT_LOOKBACK_DAYS=756
# SIGNAL_STRENGTH_STRONG_MIN=60
# SIGNAL_STRENGTH_ELIGIBLE_MIN=40
# SIGNAL_NEAR_BUY_MARGIN_PCT=5
# SIGNAL_COMPARISON_ENABLED=true

# --- 止盈后再买入（默认关闭；需要防高位加仓时可开）---
# SELL_REBUY_GATE_ENABLED=false
# SELL_REBUY_MAX_GAIN_PCT=0.30

# --- 红利股息可持续性 ---
# DIVIDEND_SUSTAINABILITY_ENABLED=true
# DIVIDEND_BUY_MAX_YIELD_SPIKE=1.50
# DIVIDEND_YIELD_SPIKE_LOOKBACK_DAYS=252
# DIVIDEND_BUY_MIN_PE=5.0
# DIVIDEND_YIELD_SPIKE_WAIVE_RANGE_PCT=0.10

# --- 创业板 PEG 增速（自动滚动 CAGR，不足回退固定值）---
# CYB_HISTORICAL_GROWTH_AUTO=true
# CYB_HISTORICAL_GROWTH=0.1663
# CYB_HISTORICAL_GROWTH_FLOOR=0.1663
# CYB_HISTORICAL_GROWTH_YEARS=5

# --- 各指数基准金额（默认均为 100，可用下方覆盖）---
# H30269_BUY_AMOUNT=100
# 000852_BUY_AMOUNT=100
# 000688_BUY_AMOUNT=100
# 399006_BUY_AMOUNT=100

# --- 红利指数（H30269，分指数配置，见 config.get_dividend_signal_config）---
# 全局默认（未单独配置的指数使用）:
# DIVIDEND_BUY_SPREAD_MIN=0.028
# DIVIDEND_BUY_SPREAD_PERCENTILE_MIN=38
# DIVIDEND_BUY_PE_PERCENTILE_MAX=72
# DIVIDEND_BUY_MAX_ABOVE_LOW_PCT=0.05
# DIVIDEND_SIGNAL_HISTORY_START=20150101
# DIVIDEND_SPREAD_10Y_WINDOW=2520
# DIVIDEND_SPREAD_HIGH_PERCENTILE_MIN=75
# H30269 低波动 默认: 利差分位≥40%, PE分位≤74%, 距90日低点涨幅≤6%
# DIVIDEND_H30269_BUY_SPREAD_PERCENTILE_MIN=40
# DIVIDEND_H30269_BUY_PE_PERCENTILE_MAX=74
# DIVIDEND_H30269_BUY_MAX_ABOVE_LOW_PCT=0.06

